# =============================================================================
# AND LIVE TRANSLATOR (vMix Broadcast Edition) - ARCHIVO DE CONFIGURACIÓN
# =============================================================================

# --- API Keys de Inteligencia Artificial ---
# Clave de Groq Cloud (Recomendada: Gratuita, ultra-baja latencia <150ms)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_groq_aqui

# Clave de OpenAI (Opcional, como respaldo)
OPENAI_API_KEY=sk-tu_clave_openai_aqui

# --- Integración con vMix ---
# Dirección IP del PC con vMix (127.0.0.1 si corre en la misma máquina)
VMIX_HOST=127.0.0.1
# Puerto de la Web API de vMix (por defecto 8088 en vMix)
VMIX_PORT=8088
# Nombre del Input GT Title en vMix que recibirá el subtítulo
VMIX_TITLE_INPUT=Subtitulos
# Nombre de la capa de texto dentro del GT Title
VMIX_TITLE_FIELD=Headline.Text

# --- Dispositivos de Audio (Opcional, configurable desde el panel web) ---
# Nombre o índice de la tarjeta de entrada (ej: CABLE Output (VB-Audio Point))
AUDIO_INPUT_DEVICE=
# Nombre o índice de la tarjeta de salida (ej: Speakers (Realtek))
AUDIO_OUTPUT_DEVICE=

# --- Idiomas por Defecto ---
# auto, en, fr, de, it, pt, zh, ja, etc.
TRANSLATOR_SOURCE_LANG=en
TRANSLATOR_TARGET_LANG=es

# --- Servicio de Voz Clonada Local (Opcional) ---
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_PROFILE_ID=
